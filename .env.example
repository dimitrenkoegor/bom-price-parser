# bom-price-parser — ключи и настройки. Скопировать в .env и заполнить.
# .env в репозиторий не попадает. Пустой ключ = площадка пропускается, падения не будет.
# Общие с count pars ключи можно перенести оттуда: у него есть `run.py init --import-env`.

# --- API дистрибьюторов (основной проход) ---
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
FARNELL_API_KEY=            # один ключ на Newark (USD) и Farnell (GBP)
TME_TOKEN=
TME_APP_SECRET=

# --- добивка RFQ-остатка: агрегаторы (enabled в config/sources.toml) ---
OEMSECRETS_API_KEY=
OEMSECRETS_DAILY_LIMIT=10   # суточная квота запросов, счётчик в work/quota.json
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
ARROW_API_KEY=
ARROW_LOGIN=

# --- LLM-контур: подсказка написания артикула для RFQ, подтверждается ценой в API ---
ENABLE_CLAUDE_FALLBACK=false
CLAUDE_MAX_ITEMS=40
# CLAUDE_BIN=C:\Users\...\AppData\Roaming\npm\claude.cmd   # если claude не в PATH

# --- почтовый монитор (mail_monitor.py) ---
MAIL_IMAP_HOST=imap.mail.ru
MAIL_IMAP_MAILBOX=INBOX
MAIL_USER=
MAIL_PASSWORD=              # пароль приложения, не основной
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
ALLOWED_SENDERS=            # через ; можно @домен
POLL_SECONDS=60
SEND_ENABLED=true
HOLD_ON_RFQ=true            # при RFQ ответ клиенту придерживается, письмо себе
